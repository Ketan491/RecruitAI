# ── Database ──────────────────────────────────────────────────────────────────
MONGODB_URI=mongodb+srv://<user>:<pass>@cluster.mongodb.net/recruitai?retryWrites=true&w=majority
DB_NAME=recruitai

# ── JWT Auth ──────────────────────────────────────────────────────────────────
JWT_SECRET=change-me-in-production-use-openssl-rand-hex-32
JWT_REFRESH_SECRET=another-secret-use-openssl-rand-hex-32
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# ── Password Reset ────────────────────────────────────────────────────────────
RESET_TOKEN_SECRET=yet-another-secret-use-openssl-rand-hex-32
RESET_TOKEN_EXPIRE_MINUTES=60

# ── AI ────────────────────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=sk-ant-api03-...
ANTHROPIC_MODEL=claude-sonnet-4-20250514

# ── AWS S3 (resume storage) ───────────────────────────────────────────────────
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_S3_BUCKET=recruitai-resumes
AWS_REGION=ap-south-1

# ── SMTP Email (optional - app works without it, emails are logged) ───────────
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your@gmail.com
SMTP_PASSWORD=your-app-password
SMTP_FROM=noreply@recruitai.app
SMTP_TLS=true

# ── App ───────────────────────────────────────────────────────────────────────
FRONTEND_URL=http://localhost:5173
CORS_ORIGINS=http://localhost:5173,https://your-domain.vercel.app
ENV=development
LOG_LEVEL=info
