{
  "semi": true,
  "singleQuote": true,
  "trailingComma": "all",
  "printWidth": 100,
  "tabWidth": 2,
  "useTabs": false,
  "bracketSpacing": true,
  "bracketSameLine": false,
  "arrowParens": "always",
  "endOfLine": "lf",
  "quoteProps": "as-needed",
  "proseWrap": "preserve",
  "htmlWhitespaceSensitivity": "css",
  "embeddedLanguageFormatting": "auto",
  "overrides": [
    {
      "files": ["*.json", "*.jsonc"],
      "options": { "printWidth": 80 }
    },
    {
      "files": ["*.md"],
      "options": { "proseWrap": "always", "printWidth": 80 }
    },
    {
      "files": ["*.yaml", "*.yml"],
      "options": { "singleQuote": false }
    },
    {
      "files": ["*.html"],
      "options": { "printWidth": 120, "singleAttributePerLine": true }
    }
  ]
}
